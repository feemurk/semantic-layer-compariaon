 "assemble": "WITH t AS (SELECT sales_territory FROM territories WHERE lines > 0 ORDER BY revenue DESC, sales_territory LIMIT 1), m AS (SELECT months.fiscal_month FROM months JOIN t USING (sales_territory) WHERE lines > 0 ORDER BY revenue DESC, fiscal_month LIMIT 1) SELECT grain, sales_territory, fiscal_month, state_province, city, revenue FROM ( SELECT 'state' AS grain, s.sales_territory, s.fiscal_month, s.state_province, CAST(NULL AS VARCHAR) AS city, s.revenue FROM states s JOIN t USING (sales_territory) JOIN m USING (fiscal_month) WHERE s.lines > 0 UNION ALL SELECT 'city', c.sales_territory, c.fiscal_month, c.state_province, c.city, c.revenue FROM cities c JOIN t USING (sales_territory) JOIN m USING (fiscal_month) WHERE c.lines > 0 ) r ORDER BY grain DESC, state_province, city NULLS FIRST"
