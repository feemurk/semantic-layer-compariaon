 "assemble": "WITH top_zone AS (SELECT pu_location_id, pace_index FROM zones WHERE trips > 0 AND ytd_trips >= 50000 ORDER BY pace_index DESC, pu_location_id LIMIT 1), names AS (SELECT DISTINCT pu_location_id, zone FROM daily) SELECT t.pu_location_id, n.zone, t.pace_index, d.pickup_date, c.trips FROM days d CROSS JOIN top_zone t JOIN names n ON n.pu_location_id = t.pu_location_id LEFT JOIN daily c ON c.pickup_date = d.pickup_date AND c.pu_location_id = t.pu_location_id AND c.trips > 0 ORDER BY d.pickup_date",
