 "assemble": "WITH g AS (SELECT stock_group_name, revenue AS group_revenue FROM groups WHERE lines > 0 AND stock_group_name IS NOT NULL ORDER BY revenue DESC, stock_group_name LIMIT 1) SELECT g.stock_group_name, i.wwi_stock_item_id, i.stock_item, i.revenue, i.revenue / g.group_revenue AS share_of_group FROM items i JOIN g USING (stock_group_name) WHERE i.lines > 0 ORDER BY share_of_group DESC, i.wwi_stock_item_id"
