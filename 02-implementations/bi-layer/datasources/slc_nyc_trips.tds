<?xml version='1.0' encoding='utf-8' ?>
<!-- SLC NYC Trips: published data source of stack S3. Generated by build_tableau.py from model.py; edit the builder, not this file. -->
<datasource xmlns:user="http://www.tableausoftware.com/xml/user" formatted-name="SLC NYC Trips" inline="true" source-platform="linux" version="26.3">
  <document-format-change-manifest>
    <ManifestByVersion />
  </document-format-change-manifest>
  <connection class="federated">
    <named-connections>
      <named-connection caption="SLC Databricks SQL (serverless)" name="databricks.slc">
        <connection class="databricks" authentication="auth-pass" username="token" port="443" sslmode="require" dbname="slc" />
      </named-connection>
    </named-connections>
    <relation type="collection">
      <relation connection="databricks.slc" name="Trips" type="text">SELECT t.trip_id AS trip_id, t.vendor_id AS trip_vendor_id, t.pickup_ts AS trip_pickup_ts, t.pickup_date AS trip_pickup_date, t.dropoff_date AS trip_dropoff_date, t.pickup_hour AS trip_pickup_hour, t.pu_location_id AS trip_pu_location_id, t.do_location_id AS trip_do_location_id, t.od_pair_id AS trip_od_pair_id, t.trip_distance AS trip_trip_distance, t.payment_type AS trip_payment_type, t.fare_amount AS trip_fare_amount, t.tip_amount AS trip_tip_amount, t.tolls_amount AS trip_tolls_amount, t.total_amount AS trip_total_amount, z.borough AS trip_rls_pickup_borough FROM slc.nyctaxi.fact_trip t LEFT JOIN slc.nyctaxi.dim_zone z ON z.location_id = t.pu_location_id</relation>
      <relation connection="databricks.slc" name="Pickup Calendar" type="text">SELECT date_key AS pc_date_key, calendar_year AS pc_calendar_year, calendar_quarter AS pc_calendar_quarter, calendar_month AS pc_calendar_month, month_name AS pc_month_name, month_start_date AS pc_month_start_date, day_of_month AS pc_day_of_month, day_of_year AS pc_day_of_year, day_of_week AS pc_day_of_week, day_name AS pc_day_name, fiscal_year AS pc_fiscal_year, fiscal_quarter AS pc_fiscal_quarter, fiscal_month AS pc_fiscal_month FROM slc.nyctaxi.dim_date</relation>
      <relation connection="databricks.slc" name="Pickup Zone" type="text">SELECT location_id AS pz_location_id, borough AS pz_borough, zone AS pz_zone, service_zone AS pz_service_zone FROM slc.nyctaxi.dim_zone</relation>
      <relation connection="databricks.slc" name="Dropoff Zone" type="text">SELECT location_id AS dz_location_id, borough AS dz_borough, zone AS dz_zone, service_zone AS dz_service_zone FROM slc.nyctaxi.dim_zone</relation>
      <relation connection="databricks.slc" name="Payment Type" type="text">SELECT payment_type AS pt_payment_type, payment_type_name AS pt_payment_type_name FROM slc.nyctaxi.dim_payment_type</relation>
    </relation>
    <cols>
      <map key="[trip_id]" value="[Trips].[trip_id]" />
      <map key="[trip_vendor_id]" value="[Trips].[trip_vendor_id]" />
      <map key="[trip_pickup_ts]" value="[Trips].[trip_pickup_ts]" />
      <map key="[trip_pickup_date]" value="[Trips].[trip_pickup_date]" />
      <map key="[trip_dropoff_date]" value="[Trips].[trip_dropoff_date]" />
      <map key="[trip_pickup_hour]" value="[Trips].[trip_pickup_hour]" />
      <map key="[trip_pu_location_id]" value="[Trips].[trip_pu_location_id]" />
      <map key="[trip_do_location_id]" value="[Trips].[trip_do_location_id]" />
      <map key="[trip_od_pair_id]" value="[Trips].[trip_od_pair_id]" />
      <map key="[trip_trip_distance]" value="[Trips].[trip_trip_distance]" />
      <map key="[trip_payment_type]" value="[Trips].[trip_payment_type]" />
      <map key="[trip_fare_amount]" value="[Trips].[trip_fare_amount]" />
      <map key="[trip_tip_amount]" value="[Trips].[trip_tip_amount]" />
      <map key="[trip_tolls_amount]" value="[Trips].[trip_tolls_amount]" />
      <map key="[trip_total_amount]" value="[Trips].[trip_total_amount]" />
      <map key="[trip_rls_pickup_borough]" value="[Trips].[trip_rls_pickup_borough]" />
      <map key="[pc_date_key]" value="[Pickup Calendar].[pc_date_key]" />
      <map key="[pc_calendar_year]" value="[Pickup Calendar].[pc_calendar_year]" />
      <map key="[pc_calendar_quarter]" value="[Pickup Calendar].[pc_calendar_quarter]" />
      <map key="[pc_calendar_month]" value="[Pickup Calendar].[pc_calendar_month]" />
      <map key="[pc_month_name]" value="[Pickup Calendar].[pc_month_name]" />
      <map key="[pc_month_start_date]" value="[Pickup Calendar].[pc_month_start_date]" />
      <map key="[pc_day_of_month]" value="[Pickup Calendar].[pc_day_of_month]" />
      <map key="[pc_day_of_year]" value="[Pickup Calendar].[pc_day_of_year]" />
      <map key="[pc_day_of_week]" value="[Pickup Calendar].[pc_day_of_week]" />
      <map key="[pc_day_name]" value="[Pickup Calendar].[pc_day_name]" />
      <map key="[pc_fiscal_year]" value="[Pickup Calendar].[pc_fiscal_year]" />
      <map key="[pc_fiscal_quarter]" value="[Pickup Calendar].[pc_fiscal_quarter]" />
      <map key="[pc_fiscal_month]" value="[Pickup Calendar].[pc_fiscal_month]" />
      <map key="[pz_location_id]" value="[Pickup Zone].[pz_location_id]" />
      <map key="[pz_borough]" value="[Pickup Zone].[pz_borough]" />
      <map key="[pz_zone]" value="[Pickup Zone].[pz_zone]" />
      <map key="[pz_service_zone]" value="[Pickup Zone].[pz_service_zone]" />
      <map key="[dz_location_id]" value="[Dropoff Zone].[dz_location_id]" />
      <map key="[dz_borough]" value="[Dropoff Zone].[dz_borough]" />
      <map key="[dz_zone]" value="[Dropoff Zone].[dz_zone]" />
      <map key="[dz_service_zone]" value="[Dropoff Zone].[dz_service_zone]" />
      <map key="[pt_payment_type]" value="[Payment Type].[pt_payment_type]" />
      <map key="[pt_payment_type_name]" value="[Payment Type].[pt_payment_type_name]" />
    </cols>
  </connection>
  <aliases enabled="yes" />
  <column caption="As-of Date" datatype="date" name="[p_as_of_date]" param-domain-type="any" role="measure" type="quantitative" value="#2024-12-31#">
    <calculation class="tableau" formula="#2024-12-31#" />
    <desc>
      <formatted-text>
        <run>Anchor date for year-to-date, same-time-last-year and month-to-date measures.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Trip ID" datatype="integer" name="[trip_id]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Vendor" datatype="integer" name="[trip_vendor_id]" role="dimension" type="ordinal">
    <desc>
      <formatted-text>
        <run>TLC technology provider id that recorded the trip. Also called: vendor id, provider, TPEP provider.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Pickup Timestamp" datatype="datetime" name="[trip_pickup_ts]" role="dimension" type="ordinal">
    <desc>
      <formatted-text>
        <run>Pickup date and time (incremental extract key).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Pickup Date" datatype="date" name="[trip_pickup_date]" role="dimension" type="ordinal">
    <desc>
      <formatted-text>
        <run>Date the trip started; the anchor for year-to-date and pace metrics. Also called: trip date, pickup day, date.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Dropoff Date" datatype="date" name="[trip_dropoff_date]" role="dimension" type="ordinal">
    <desc>
      <formatted-text>
        <run>Date the trip ended (role of the Date dimension); differs from pickup date for trips crossing midnight. Also called: dropoff day, trip end date, arrival date.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Pickup Hour" datatype="integer" name="[trip_pickup_hour]" role="dimension" type="ordinal">
    <desc>
      <formatted-text>
        <run>Hour of day the trip started, 0-23. Also called: hour, time of day, hour of day.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Trip Pickup Location ID" datatype="integer" name="[trip_pu_location_id]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Trip Dropoff Location ID" datatype="integer" name="[trip_do_location_id]" role="dimension" type="ordinal" hidden="true" />
  <column caption="OD Pair ID" datatype="integer" name="[trip_od_pair_id]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Trip Distance" datatype="real" name="[trip_trip_distance]" role="measure" type="quantitative" aggregation="Sum" hidden="true" />
  <column caption="Trip Payment Type Code" datatype="integer" name="[trip_payment_type]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Trip Fare Amount" datatype="real" name="[trip_fare_amount]" role="measure" type="quantitative" aggregation="Sum" hidden="true" />
  <column caption="Trip Tip Amount" datatype="real" name="[trip_tip_amount]" role="measure" type="quantitative" aggregation="Sum" hidden="true" />
  <column caption="Trip Tolls Amount" datatype="real" name="[trip_tolls_amount]" role="measure" type="quantitative" aggregation="Sum" hidden="true" />
  <column caption="Trip Total Amount" datatype="real" name="[trip_total_amount]" role="measure" type="quantitative" aggregation="Sum" hidden="true" />
  <column caption="RLS Pickup Borough" datatype="string" name="[trip_rls_pickup_borough]" role="dimension" type="nominal" hidden="true" />
  <column caption="Pickup Calendar Date" datatype="date" name="[pc_date_key]" role="dimension" type="ordinal" />
  <column caption="Pickup Year" datatype="integer" name="[pc_calendar_year]" role="dimension" type="ordinal" />
  <column caption="Pickup Quarter" datatype="integer" name="[pc_calendar_quarter]" role="dimension" type="ordinal" />
  <column caption="Pickup Calendar Month" datatype="integer" name="[pc_calendar_month]" role="dimension" type="ordinal" />
  <column caption="Pickup Calendar month_name" datatype="string" name="[pc_month_name]" role="dimension" type="nominal" hidden="true" />
  <column caption="Pickup Month Start Date" datatype="date" name="[pc_month_start_date]" role="dimension" type="ordinal" />
  <column caption="Pickup Calendar day_of_month" datatype="integer" name="[pc_day_of_month]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Pickup Calendar day_of_year" datatype="integer" name="[pc_day_of_year]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Pickup Day of Week" datatype="integer" name="[pc_day_of_week]" role="dimension" type="ordinal" />
  <column caption="Pickup Day Name" datatype="string" name="[pc_day_name]" role="dimension" type="nominal" />
  <column caption="Pickup Calendar fiscal_year" datatype="integer" name="[pc_fiscal_year]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Pickup Calendar fiscal_quarter" datatype="integer" name="[pc_fiscal_quarter]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Pickup Calendar fiscal_month" datatype="integer" name="[pc_fiscal_month]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Pickup Zone ID" datatype="integer" name="[pz_location_id]" role="dimension" type="ordinal" />
  <column caption="Pickup Borough" datatype="string" name="[pz_borough]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Borough of the pickup zone.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Pickup Zone" datatype="string" name="[pz_zone]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>TLC taxi zone where the trip started (role of the Zone dimension). Also called: origin, pickup location, pickup borough, from.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Pickup Service Zone" datatype="string" name="[pz_service_zone]" role="dimension" type="nominal" />
  <column caption="Dropoff Zone ID" datatype="integer" name="[dz_location_id]" role="dimension" type="ordinal" />
  <column caption="Dropoff Borough" datatype="string" name="[dz_borough]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Borough of the dropoff zone.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Dropoff Zone" datatype="string" name="[dz_zone]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>TLC taxi zone where the trip ended (role of the Zone dimension). Also called: destination, dropoff location, dropoff borough, to.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Dropoff Service Zone" datatype="string" name="[dz_service_zone]" role="dimension" type="nominal" />
  <column caption="Payment Type Code" datatype="integer" name="[pt_payment_type]" role="dimension" type="ordinal" />
  <column caption="Payment Type" datatype="string" name="[pt_payment_type_name]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>TLC payment type code and label (0 Flex Fare trip, 1 Credit card, 2 Cash, 3 No charge, 4 Dispute, 5 Unknown, 6 Voided trip). Also called: payment method, paid by, tender.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Dropoff Year" datatype="integer" name="[dropoff_year]" role="dimension" type="ordinal">
    <calculation class="tableau" formula="YEAR([trip_dropoff_date])" />
    <desc>
      <formatted-text>
        <run>Calendar year of the dropoff date.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Dropoff Month Start Date" datatype="date" name="[dropoff_month_start]" role="dimension" type="ordinal">
    <calculation class="tableau" formula="DATE(DATETRUNC('month', [trip_dropoff_date]))" />
    <desc>
      <formatted-text>
        <run>First day of the dropoff month.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Trip Count" datatype="integer" name="[m_trip_count]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="COUNT([trip_id])" />
    <desc>
      <formatted-text>
        <run>Count of valid Yellow Taxi trips (fact_trip rows). Also called: trips, number of trips, rides, ride count.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Total Trip Distance" datatype="real" name="[m_total_trip_distance]" role="measure" type="quantitative" default-format="n#,##0.00">
    <calculation class="tableau" formula="SUM([trip_trip_distance])" />
    <desc>
      <formatted-text>
        <run>Sum of trip distance in miles (fact_trip.trip_distance). Also called: miles, distance, total miles, trip miles.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Fare Amount" datatype="real" name="[m_fare_amount]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00">
    <calculation class="tableau" formula="SUM([trip_fare_amount])" />
    <desc>
      <formatted-text>
        <run>Sum of metered fares (fact_trip.fare_amount), excluding tips, tolls and surcharges. Also called: fares, metered fare, fare revenue.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Tip Amount (All Payment Types)" datatype="real" name="[m_tip_amount]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00">
    <calculation class="tableau" formula="SUM([trip_tip_amount])" />
    <desc>
      <formatted-text>
        <run>Sum of recorded tips across all payment types (fact_trip.tip_amount). TLC records tips only for card payments. Also called: tips, all tips, gratuity.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Tolls Amount" datatype="real" name="[m_tolls_amount]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00">
    <calculation class="tableau" formula="SUM([trip_tolls_amount])" />
    <desc>
      <formatted-text>
        <run>Sum of tolls (fact_trip.tolls_amount). Also called: tolls, toll charges, bridge and tunnel tolls.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Gross Trip Revenue" datatype="real" name="[m_gross_trip_revenue]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00">
    <calculation class="tableau" formula="SUM([trip_total_amount])" />
    <desc>
      <formatted-text>
        <run>Sum of total amount charged (fact_trip.total_amount). Also called: revenue, trip revenue, total amount, gross revenue, takings.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Card Tips" datatype="real" name="[m_card_tips]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00">
    <calculation class="tableau" formula="SUM(IF [trip_payment_type] = 1 THEN [trip_tip_amount] END)" />
    <desc>
      <formatted-text>
        <run>Sum of tips on credit card trips (payment type 1); blank for other payment types. Also called: credit card tips, card gratuity, tips on card.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Distinct OD Pairs" datatype="integer" name="[m_distinct_od_pairs]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="COUNTD([trip_od_pair_id])" />
    <desc>
      <formatted-text>
        <run>Exact count of distinct pickup zone to dropoff zone pairs. Additive across zone and borough of either role; not additive across time, payment type, vendor or hour. Also called: origin destination pairs, OD pairs, unique routes, distinct routes.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Fare per Mile" datatype="real" name="[m_fare_per_mile]" role="measure" type="quantitative" default-format="n#,##0.00">
    <calculation class="tableau" formula="SUM([trip_fare_amount]) / SUM([trip_trip_distance])" />
    <desc>
      <formatted-text>
        <run>Fare Amount divided by Total Trip Distance, computed from the aggregated sums at every grain. Also called: fare per mile, price per mile, rate per mile.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Revenue YTD" datatype="real" name="[m_revenue_ytd]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00">
    <calculation class="tableau" formula="SUM(IF [trip_pickup_date] &gt;= DATE(DATETRUNC('year', [p_as_of_date])) AND [trip_pickup_date] &lt;= [p_as_of_date] THEN [trip_total_amount] END)" />
    <desc>
      <formatted-text>
        <run>Gross Trip Revenue from 1 January to the period end by pickup date, compared with the same period last year (29 February maps to 28 February). Year-to-date through the As-of Date parameter. Also called: year to date revenue, YTD revenue, YoY growth, year over year, same time last year.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Revenue YTD Same Time Last Year" datatype="real" name="[m_revenue_stly_ytd]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00">
    <calculation class="tableau" formula="SUM(IF [trip_pickup_date] &gt;= DATE(DATEADD('year', -1, DATETRUNC('year', [p_as_of_date]))) AND [trip_pickup_date] &lt;= DATE(DATEADD('year', -1, [p_as_of_date])) THEN [trip_total_amount] END)" />
    <desc>
      <formatted-text>
        <run>Revenue YTD one year before the As-of Date (29 February maps to 28 February).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Revenue YoY % vs STLY" datatype="real" name="[m_revenue_yoy_pct]" role="measure" type="quantitative" default-format="p0.00%">
    <calculation class="tableau" formula="([m_revenue_ytd] - [m_revenue_stly_ytd]) / [m_revenue_stly_ytd]" />
    <desc>
      <formatted-text>
        <run>Year-over-year change of Revenue YTD against the same period last year.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Trips MTD" datatype="integer" name="[m_trips_mtd]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="SUM(IF [trip_pickup_date] &gt;= DATE(DATETRUNC('month', [p_as_of_date])) AND [trip_pickup_date] &lt;= [p_as_of_date] THEN 1 END)" />
    <desc>
      <formatted-text>
        <run>Trips from the first day of the As-of Date's month through the As-of Date.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Trips YTD" datatype="integer" name="[m_trips_ytd]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="SUM(IF [trip_pickup_date] &gt;= DATE(DATETRUNC('year', [p_as_of_date])) AND [trip_pickup_date] &lt;= [p_as_of_date] THEN 1 END)" />
    <desc>
      <formatted-text>
        <run>Trips from 1 January of the As-of Date's year through the As-of Date.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="As-of Day of Month" datatype="integer" name="[as_of_day_of_month]" role="dimension" type="ordinal">
    <calculation class="tableau" formula="DAY([p_as_of_date])" />
    <desc>
      <formatted-text>
        <run>Calendar days elapsed in the As-of Date's month.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="As-of Day of Year" datatype="integer" name="[as_of_day_of_year]" role="dimension" type="ordinal">
    <calculation class="tableau" formula="DATEPART('dayofyear', [p_as_of_date])" />
    <desc>
      <formatted-text>
        <run>Calendar days elapsed in the As-of Date's year.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="MTD-to-YTD Daily Pace Index" datatype="real" name="[m_pace_index]" role="measure" type="quantitative" default-format="n#,##0.000">
    <calculation class="tableau" formula="(ZN([m_trips_mtd]) / DAY([p_as_of_date])) / ([m_trips_ytd] / DATEPART('dayofyear', [p_as_of_date]))" />
    <desc>
      <formatted-text>
        <run>Average daily trips month-to-date divided by average daily trips year-to-date, using calendar days elapsed. Above 1 means the month is running ahead of the year's pace. Anchored on the As-of Date parameter. Also called: pace index, run rate index, month pace, daily pace.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="RLS Pickup Borough Filter" datatype="boolean" name="[rls_nyc_pickup]" role="dimension" type="nominal" hidden="true">
    <calculation class="tableau" formula="NOT ISMEMBEROF('slc_pickup_manhattan') OR [trip_rls_pickup_borough] = 'Manhattan'" />
    <desc>
      <formatted-text>
        <run>Row-level security: the Manhattan pickup group sees trips picked up in Manhattan only.</run>
      </formatted-text>
    </desc>
  </column>
  <filter class="categorical" column="[rls_nyc_pickup]" logical-table-scoped="true">
    <groupfilter function="member" level="[rls_nyc_pickup]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
  </filter>
  <object-graph>
    <objects>
      <object caption="Trips" id="trips">
        <properties context="">
          <relation connection="databricks.slc" name="Trips" type="text">SELECT t.trip_id AS trip_id, t.vendor_id AS trip_vendor_id, t.pickup_ts AS trip_pickup_ts, t.pickup_date AS trip_pickup_date, t.dropoff_date AS trip_dropoff_date, t.pickup_hour AS trip_pickup_hour, t.pu_location_id AS trip_pu_location_id, t.do_location_id AS trip_do_location_id, t.od_pair_id AS trip_od_pair_id, t.trip_distance AS trip_trip_distance, t.payment_type AS trip_payment_type, t.fare_amount AS trip_fare_amount, t.tip_amount AS trip_tip_amount, t.tolls_amount AS trip_tolls_amount, t.total_amount AS trip_total_amount, z.borough AS trip_rls_pickup_borough FROM slc.nyctaxi.fact_trip t LEFT JOIN slc.nyctaxi.dim_zone z ON z.location_id = t.pu_location_id</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Valid Yellow Taxi trips (fact_trip) with the pickup borough attached for row-level security.</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Pickup Calendar" id="pickup_calendar">
        <properties context="">
          <relation connection="databricks.slc" name="Pickup Calendar" type="text">SELECT date_key AS pc_date_key, calendar_year AS pc_calendar_year, calendar_quarter AS pc_calendar_quarter, calendar_month AS pc_calendar_month, month_name AS pc_month_name, month_start_date AS pc_month_start_date, day_of_month AS pc_day_of_month, day_of_year AS pc_day_of_year, day_of_week AS pc_day_of_week, day_name AS pc_day_name, fiscal_year AS pc_fiscal_year, fiscal_quarter AS pc_fiscal_quarter, fiscal_month AS pc_fiscal_month FROM slc.nyctaxi.dim_date</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Calendar of the pickup date (every day of 2023-2025, with or without trips).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Pickup Zone" id="pickup_zone">
        <properties context="">
          <relation connection="databricks.slc" name="Pickup Zone" type="text">SELECT location_id AS pz_location_id, borough AS pz_borough, zone AS pz_zone, service_zone AS pz_service_zone FROM slc.nyctaxi.dim_zone</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Pickup zone role of the TLC zone dimension.</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Dropoff Zone" id="dropoff_zone">
        <properties context="">
          <relation connection="databricks.slc" name="Dropoff Zone" type="text">SELECT location_id AS dz_location_id, borough AS dz_borough, zone AS dz_zone, service_zone AS dz_service_zone FROM slc.nyctaxi.dim_zone</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Dropoff zone role of the TLC zone dimension.</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Payment Type" id="payment_type">
        <properties context="">
          <relation connection="databricks.slc" name="Payment Type" type="text">SELECT payment_type AS pt_payment_type, payment_type_name AS pt_payment_type_name FROM slc.nyctaxi.dim_payment_type</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>TLC payment type codes and labels.</run>
          </formatted-text>
        </table-description>
      </object>
    </objects>
    <relationships>
      <relationship>
        <expression op="=">
          <expression op="[trip_pickup_date]" />
          <expression op="[pc_date_key]" />
        </expression>
        <first-end-point object-id="trips" />
        <second-end-point object-id="pickup_calendar" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[trip_pu_location_id]" />
          <expression op="[pz_location_id]" />
        </expression>
        <first-end-point object-id="trips" />
        <second-end-point object-id="pickup_zone" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[trip_do_location_id]" />
          <expression op="[dz_location_id]" />
        </expression>
        <first-end-point object-id="trips" />
        <second-end-point object-id="dropoff_zone" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[trip_payment_type]" />
          <expression op="[pt_payment_type]" />
        </expression>
        <first-end-point object-id="trips" />
        <second-end-point object-id="payment_type" />
      </relationship>
    </relationships>
  </object-graph>
</datasource>
