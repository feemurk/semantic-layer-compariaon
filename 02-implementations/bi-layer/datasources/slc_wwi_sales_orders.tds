  <column caption="Sales Territory" datatype="string" name="[ci_sales_territory]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Sales territory of the city as recorded at the time of the fact; alternate hierarchy over State Province.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Region" datatype="string" name="[ci_region]" role="dimension" type="nominal" />
  <column caption="Subregion" datatype="string" name="[ci_subregion]" role="dimension" type="nominal" />
