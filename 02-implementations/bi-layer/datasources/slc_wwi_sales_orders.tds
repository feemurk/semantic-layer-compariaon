  <column caption="WWI Stock Item ID" datatype="integer" name="[si_wwi_stock_item_id]" role="dimension" type="ordinal">
    <desc>
      <formatted-text>
        <run>Durable stock item id, stable across SCD2 versions.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Stock Item" datatype="string" name="[si_stock_item]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Product as recorded at the time of sale (SCD Type 2); current attributes via the durable item id. Also called: product, item, SKU, article.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Brand" datatype="string" name="[si_brand]" role="dimension" type="nominal" />
  <column caption="Color" datatype="string" name="[si_color]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Stock item color as recorded at the time of the fact (as-was, SCD2).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Size" datatype="string" name="[si_size]" role="dimension" type="nominal" />
  <column caption="Selling Package" datatype="string" name="[si_selling_package]" role="dimension" type="nominal" />
  <column caption="Is Chiller Stock" datatype="boolean" name="[si_is_chiller_stock]" role="dimension" type="nominal" />
  <column caption="Current Stock Item ID" datatype="integer" name="[csi_wwi_stock_item_id]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Current Stock Item" datatype="string" name="[csi_stock_item]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Stock item name in its current version (as-is).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Current Color" datatype="string" name="[csi_color]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Stock item color in its current version (as-is, SCD2).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Stock Group Item ID" datatype="integer" name="[sg_wwi_stock_item_id]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Stock Group ID" datatype="integer" name="[sg_stock_group_id]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Stock Group" datatype="string" name="[sg_stock_group_name]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Product group; an item can belong to several groups, so group totals overlap. Also called: category, product group, product category, department.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Salesperson Key" datatype="integer" name="[sp_employee_key]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Salesperson" datatype="string" name="[sp_employee]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Employee credited with the sale or order (role of the Employee dimension). Also called: sales rep, seller, account manager, rep.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Picker Key" datatype="integer" name="[pk_employee_key]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Picker" datatype="string" name="[pk_employee]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Employee who picked the order (role of the Employee dimension); applies to orders only. Also called: warehouse picker, picked by, fulfiller.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Revenue (Excl. Tax)" datatype="real" name="[m_revenue]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00">
    <calculation class="tableau" formula="SUM([sale_total_excluding_tax])" />
    <desc>
      <formatted-text>
        <run>Sum of invoice line totals excluding tax (fact_sale.total_excluding_tax), dated by invoice date. Also called: revenue, sales, net sales, sales revenue, turnover, revenue excluding tax.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Revenue Including Tax" datatype="real" name="[m_revenue_including_tax]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00">
    <calculation class="tableau" formula="SUM([sale_total_including_tax])" />
    <desc>
      <formatted-text>
        <run>Sum of invoice line totals including tax (fact_sale.total_including_tax). Also called: gross revenue incl tax, revenue with tax, total including tax, invoiced amount.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Gross Profit" datatype="real" name="[m_gross_profit]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00">
    <calculation class="tableau" formula="SUM([sale_profit])" />
    <desc>
      <formatted-text>
        <run>Sum of invoice line profit (fact_sale.profit). Also called: profit, margin dollars, gross margin amount.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Units Sold" datatype="integer" name="[m_units_sold]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="SUM([sale_quantity])" />
    <desc>
      <formatted-text>
        <run>Sum of invoiced quantity (fact_sale.quantity). Also called: quantity sold, sold units, sales quantity, units invoiced.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Invoice Count" datatype="integer" name="[m_invoice_count]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="COUNTD([sale_wwi_invoice_id])" />
    <desc>
      <formatted-text>
        <run>Exact count of distinct invoices (fact_sale.wwi_invoice_id). Not additive across any dimension. Also called: number of invoices, invoices, distinct invoices.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Gross Margin %" datatype="real" name="[m_gross_margin_pct]" role="measure" type="quantitative" default-format="p0.00%">
    <calculation class="tableau" formula="SUM([sale_profit]) / SUM([sale_total_excluding_tax])" />
    <desc>
      <formatted-text>
        <run>Gross Profit divided by Revenue (Excl. Tax), computed from the aggregated numerator and denominator at every grain. Also called: margin, gross margin, GM%, margin percent, profit margin.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Ordered Quantity" datatype="integer" name="[m_ordered_quantity]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="SUM([ord_quantity])" />
    <desc>
      <formatted-text>
        <run>Sum of ordered quantity (fact_order.quantity), dated by order date. Also called: units ordered, order quantity, quantity ordered, demand.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Backordered Order Lines" datatype="integer" name="[m_backordered_order_lines]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="IF COUNT([ord_wwi_backorder_id]) &gt; 0 THEN COUNT([ord_wwi_backorder_id]) END" />
    <desc>
      <formatted-text>
        <run>Count of order lines with a backorder (fact_order.wwi_backorder_id is not null); blank when no line qualifies. Also called: backorders, backordered lines, lines on backorder.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Stock Group Revenue Share" datatype="real" name="[m_stock_group_revenue_share]" role="measure" type="quantitative" default-format="p0.00%">
    <calculation class="tableau" formula="SUM([sale_total_excluding_tax]) / MIN({EXCLUDE [sg_stock_group_name] : SUM([sale_total_excluding_tax])})" />
    <desc>
      <formatted-text>
        <run>Revenue of items in a stock group divided by revenue of the same context without the stock group filter. Items can belong to several groups, so shares do not add to 100%. Denominator: revenue of the same context with Stock Group removed, counting each line once. Also called: category share, group share, share of revenue, revenue mix.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Sales Line Count" datatype="integer" name="[m_sales_line_count]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="COUNT([sale_key])" />
    <desc>
      <formatted-text>
        <run>Number of invoice lines in context (row presence of the sales fact).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Order Line Count" datatype="integer" name="[m_order_line_count]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="COUNT([ord_order_key])" />
    <desc>
      <formatted-text>
        <run>Number of order lines in context (row presence of the orders fact).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Revenue (All Stock Groups)" datatype="real" name="[m_revenue_all_stock_groups]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00">
    <calculation class="tableau" formula="MIN({EXCLUDE [sg_stock_group_name] : SUM([sale_total_excluding_tax])})" />
    <desc>
      <formatted-text>
        <run>Revenue of the current context with Stock Group removed; each invoice line counted once. The denominator of Stock Group Revenue Share.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="RLS Territory Filter" datatype="boolean" name="[rls_wwi_territory]" role="dimension" type="nominal" hidden="true">
    <calculation class="tableau" formula="NOT ISMEMBEROF('slc_territory_southeast') OR [ci_sales_territory] = 'Southeast'" />
    <desc>
      <formatted-text>
        <run>Row-level security: members of the Southeast territory group see Southeast sales and orders only.</run>
      </formatted-text>
    </desc>
  </column>
  <filter class="categorical" column="[rls_wwi_territory]">
    <groupfilter function="member" level="[rls_wwi_territory]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
  </filter>
  <object-graph>
    <objects>
      <object caption="Sales" id="sales">
        <properties context="">
          <relation connection="databricks.slc" name="Sales" type="text">SELECT sale_key AS sale_key, invoice_date AS sale_invoice_date, delivery_date AS sale_delivery_date, city_key AS sale_city_key, customer_key AS sale_customer_key, bill_to_customer_key AS sale_bill_to_customer_key, stock_item_key AS sale_stock_item_key, salesperson_key AS sale_salesperson_key, wwi_invoice_id AS sale_wwi_invoice_id, quantity AS sale_quantity, total_excluding_tax AS sale_total_excluding_tax, profit AS sale_profit, total_including_tax AS sale_total_including_tax FROM slc.wwi.fact_sale</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Invoice lines (fact_sale), one row per line.</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Orders" id="orders">
        <properties context="">
          <relation connection="databricks.slc" name="Orders" type="text">SELECT order_key AS ord_order_key, order_date AS ord_order_date, city_key AS ord_city_key, customer_key AS ord_customer_key, stock_item_key AS ord_stock_item_key, salesperson_key AS ord_salesperson_key, picker_key AS ord_picker_key, wwi_order_id AS ord_wwi_order_id, wwi_backorder_id AS ord_wwi_backorder_id, quantity AS ord_quantity, total_excluding_tax AS ord_total_excluding_tax FROM slc.wwi.fact_order</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Order lines (fact_order), one row per line.</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Date" id="date">
        <properties context="">
          <relation connection="databricks.slc" name="Date" type="text">SELECT date_key AS d_date_key, calendar_year AS d_calendar_year, calendar_quarter AS d_calendar_quarter, calendar_month AS d_calendar_month, month_name AS d_month_name, month_start_date AS d_month_start_date, day_of_month AS d_day_of_month, day_of_year AS d_day_of_year, day_of_week AS d_day_of_week, day_name AS d_day_name, fiscal_year AS d_fiscal_year, fiscal_quarter AS d_fiscal_quarter, fiscal_month AS d_fiscal_month FROM slc.wwi.dim_date</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Shared calendar: invoice date for sales, order date for orders (fiscal year starts 1 November).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Delivery Date" id="delivery_date">
        <properties context="">
          <relation connection="databricks.slc" name="Delivery Date" type="text">SELECT date_key AS dd_date_key, calendar_year AS dd_calendar_year, calendar_quarter AS dd_calendar_quarter, calendar_month AS dd_calendar_month, month_name AS dd_month_name, month_start_date AS dd_month_start_date, day_of_month AS dd_day_of_month, day_of_year AS dd_day_of_year, day_of_week AS dd_day_of_week, day_name AS dd_day_name, fiscal_year AS dd_fiscal_year, fiscal_quarter AS dd_fiscal_quarter, fiscal_month AS dd_fiscal_month FROM slc.wwi.dim_date</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Delivery date role of the calendar (sales only).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Customer" id="customer">
        <properties context="">
          <relation connection="databricks.slc" name="Customer" type="text">SELECT customer_key AS c_customer_key, wwi_customer_id AS c_wwi_customer_id, customer AS c_customer, category AS c_category, buying_group AS c_buying_group FROM slc.wwi.dim_customer</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Customer as recorded at the time of the fact (shared by sales and orders).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Bill-To Customer" id="bill_to_customer">
        <properties context="">
          <relation connection="databricks.slc" name="Bill-To Customer" type="text">SELECT customer_key AS bc_customer_key, customer AS bc_customer FROM slc.wwi.dim_customer</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Bill-to customer role of the customer dimension (sales only).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="City" id="city">
        <properties context="">
          <relation connection="databricks.slc" name="City" type="text">SELECT city_key AS ci_city_key, city AS ci_city, state_province AS ci_state_province, country AS ci_country, continent AS ci_continent, sales_territory AS ci_sales_territory, region AS ci_region, subregion AS ci_subregion FROM slc.wwi.dim_city</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Delivery city as recorded at the time of the fact (shared by sales and orders).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Stock Item" id="stock_item">
        <properties context="">
          <relation connection="databricks.slc" name="Stock Item" type="text">SELECT stock_item_key AS si_stock_item_key, wwi_stock_item_id AS si_wwi_stock_item_id, stock_item AS si_stock_item, brand AS si_brand, color AS si_color, size AS si_size, selling_package AS si_selling_package, is_chiller_stock AS si_is_chiller_stock FROM slc.wwi.dim_stock_item</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Stock item version referenced by the fact's surrogate key (as-was attribution).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Current Stock Item" id="current_stock_item">
        <properties context="">
          <relation connection="databricks.slc" name="Current Stock Item" type="text">SELECT wwi_stock_item_id AS csi_wwi_stock_item_id, stock_item AS csi_stock_item, color AS csi_color FROM slc.wwi.dim_stock_item WHERE is_current</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Current version of each stock item, related through the durable id (as-is attribution).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Stock Group Membership" id="stock_group">
        <properties context="">
          <relation connection="databricks.slc" name="Stock Group Membership" type="text">SELECT b.wwi_stock_item_id AS sg_wwi_stock_item_id, g.stock_group_id AS sg_stock_group_id, g.stock_group_name AS sg_stock_group_name FROM slc.wwi.bridge_stock_item_group b JOIN slc.wwi.dim_stock_group g ON g.stock_group_id = b.stock_group_id</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Stock item to stock group membership (many-to-many bridge with group names).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Salesperson" id="salesperson">
        <properties context="">
          <relation connection="databricks.slc" name="Salesperson" type="text">SELECT employee_key AS sp_employee_key, employee AS sp_employee FROM slc.wwi.dim_employee</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Salesperson role of the employee dimension (shared by sales and orders).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Picker" id="picker">
        <properties context="">
          <relation connection="databricks.slc" name="Picker" type="text">SELECT employee_key AS pk_employee_key, employee AS pk_employee FROM slc.wwi.dim_employee</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Picker role of the employee dimension (orders only).</run>
          </formatted-text>
        </table-description>
      </object>
    </objects>
    <relationships>
      <relationship>
        <expression op="=">
          <expression op="[sale_invoice_date]" />
          <expression op="[d_date_key]" />
        </expression>
        <first-end-point object-id="sales" />
        <second-end-point object-id="date" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[ord_order_date]" />
          <expression op="[d_date_key]" />
        </expression>
        <first-end-point object-id="orders" />
        <second-end-point object-id="date" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[sale_delivery_date]" />
          <expression op="[dd_date_key]" />
        </expression>
        <first-end-point object-id="sales" />
        <second-end-point object-id="delivery_date" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[sale_customer_key]" />
          <expression op="[c_customer_key]" />
        </expression>
        <first-end-point object-id="sales" />
        <second-end-point object-id="customer" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[ord_customer_key]" />
          <expression op="[c_customer_key]" />
        </expression>
        <first-end-point object-id="orders" />
        <second-end-point object-id="customer" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[sale_bill_to_customer_key]" />
          <expression op="[bc_customer_key]" />
        </expression>
        <first-end-point object-id="sales" />
        <second-end-point object-id="bill_to_customer" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[sale_city_key]" />
          <expression op="[ci_city_key]" />
        </expression>
        <first-end-point object-id="sales" />
        <second-end-point object-id="city" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[ord_city_key]" />
          <expression op="[ci_city_key]" />
        </expression>
        <first-end-point object-id="orders" />
        <second-end-point object-id="city" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[sale_stock_item_key]" />
          <expression op="[si_stock_item_key]" />
        </expression>
        <first-end-point object-id="sales" />
        <second-end-point object-id="stock_item" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[ord_stock_item_key]" />
          <expression op="[si_stock_item_key]" />
        </expression>
        <first-end-point object-id="orders" />
        <second-end-point object-id="stock_item" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[si_wwi_stock_item_id]" />
          <expression op="[csi_wwi_stock_item_id]" />
        </expression>
        <first-end-point object-id="stock_item" />
        <second-end-point object-id="current_stock_item" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[si_wwi_stock_item_id]" />
          <expression op="[sg_wwi_stock_item_id]" />
        </expression>
        <first-end-point object-id="stock_item" />
        <second-end-point object-id="stock_group" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[sale_salesperson_key]" />
          <expression op="[sp_employee_key]" />
        </expression>
        <first-end-point object-id="sales" />
        <second-end-point object-id="salesperson" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[ord_salesperson_key]" />
          <expression op="[sp_employee_key]" />
        </expression>
        <first-end-point object-id="orders" />
        <second-end-point object-id="salesperson" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[ord_picker_key]" />
          <expression op="[pk_employee_key]" />
        </expression>
        <first-end-point object-id="orders" />
        <second-end-point object-id="picker" />
      </relationship>
    </relationships>
  </object-graph>
</datasource>
