    <desc>
      <formatted-text>
        <run>Delivery city as recorded at the time of sale; Sales Territory is an alternate hierarchy over State Province. Also called: location, territory, sales territory, state, region.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="State Province" datatype="string" name="[ci_state_province]" role="dimension" type="nominal" />
