<?xml version='1.0' encoding='utf-8' ?>
<!-- SLC WWI Stock: published data source of stack S3. Generated by build_tableau.py from model.py; edit the builder, not this file. -->
<datasource xmlns:user="http://www.tableausoftware.com/xml/user" formatted-name="SLC WWI Stock" inline="true" source-platform="linux" version="26.3">
  <document-format-change-manifest>
    <ManifestByVersion />
  </document-format-change-manifest>
  <connection class="federated">
    <named-connections>
      <named-connection caption="SLC Databricks SQL (serverless)" name="databricks.slc">
        <connection class="databricks" authentication="auth-pass" username="token" port="443" sslmode="require" dbname="slc" />
      </named-connection>
    </named-connections>
    <relation type="collection">
      <relation connection="databricks.slc" name="Stock Daily" type="text">SELECT h.snapshot_date AS stk_snapshot_date, h.wwi_stock_item_id AS stk_wwi_stock_item_id, h.stock_item_key AS stk_stock_item_key, h.quantity_on_hand AS stk_quantity_on_hand, h.balance_basis AS stk_balance_basis, SUM(s.units_sold) OVER (PARTITION BY h.wwi_stock_item_id ORDER BY h.snapshot_date ROWS BETWEEN 90 PRECEDING AND CURRENT ROW) AS stk_units_sold_91d FROM slc.wwi.fact_stock_holding_daily h LEFT JOIN (SELECT si.wwi_stock_item_id, f.invoice_date, SUM(f.quantity) AS units_sold FROM slc.wwi.fact_sale f JOIN slc.wwi.dim_stock_item si ON si.stock_item_key = f.stock_item_key GROUP BY si.wwi_stock_item_id, f.invoice_date) s ON s.wwi_stock_item_id = h.wwi_stock_item_id AND s.invoice_date = h.snapshot_date</relation>
      <relation connection="databricks.slc" name="Date" type="text">SELECT date_key AS d_date_key, calendar_year AS d_calendar_year, calendar_quarter AS d_calendar_quarter, calendar_month AS d_calendar_month, month_name AS d_month_name, month_start_date AS d_month_start_date, day_of_month AS d_day_of_month, day_of_year AS d_day_of_year, day_of_week AS d_day_of_week, day_name AS d_day_name, fiscal_year AS d_fiscal_year, fiscal_quarter AS d_fiscal_quarter, fiscal_month AS d_fiscal_month FROM slc.wwi.dim_date</relation>
      <relation connection="databricks.slc" name="Stock Item" type="text">SELECT stock_item_key AS si_stock_item_key, wwi_stock_item_id AS si_wwi_stock_item_id, stock_item AS si_stock_item, brand AS si_brand, color AS si_color, size AS si_size, selling_package AS si_selling_package, is_chiller_stock AS si_is_chiller_stock FROM slc.wwi.dim_stock_item</relation>
      <relation connection="databricks.slc" name="Current Stock Item" type="text">SELECT wwi_stock_item_id AS csi_wwi_stock_item_id, stock_item AS csi_stock_item, color AS csi_color FROM slc.wwi.dim_stock_item WHERE is_current</relation>
      <relation connection="databricks.slc" name="Stock Group Membership" type="text">SELECT b.wwi_stock_item_id AS sg_wwi_stock_item_id, g.stock_group_id AS sg_stock_group_id, g.stock_group_name AS sg_stock_group_name FROM slc.wwi.bridge_stock_item_group b JOIN slc.wwi.dim_stock_group g ON g.stock_group_id = b.stock_group_id</relation>
    </relation>
    <cols>
      <map key="[stk_snapshot_date]" value="[Stock Daily].[stk_snapshot_date]" />
      <map key="[stk_wwi_stock_item_id]" value="[Stock Daily].[stk_wwi_stock_item_id]" />
      <map key="[stk_stock_item_key]" value="[Stock Daily].[stk_stock_item_key]" />
      <map key="[stk_quantity_on_hand]" value="[Stock Daily].[stk_quantity_on_hand]" />
      <map key="[stk_balance_basis]" value="[Stock Daily].[stk_balance_basis]" />
      <map key="[stk_units_sold_91d]" value="[Stock Daily].[stk_units_sold_91d]" />
      <map key="[d_date_key]" value="[Date].[d_date_key]" />
      <map key="[d_calendar_year]" value="[Date].[d_calendar_year]" />
      <map key="[d_calendar_quarter]" value="[Date].[d_calendar_quarter]" />
      <map key="[d_calendar_month]" value="[Date].[d_calendar_month]" />
      <map key="[d_month_name]" value="[Date].[d_month_name]" />
      <map key="[d_month_start_date]" value="[Date].[d_month_start_date]" />
      <map key="[d_day_of_month]" value="[Date].[d_day_of_month]" />
      <map key="[d_day_of_year]" value="[Date].[d_day_of_year]" />
      <map key="[d_day_of_week]" value="[Date].[d_day_of_week]" />
      <map key="[d_day_name]" value="[Date].[d_day_name]" />
      <map key="[d_fiscal_year]" value="[Date].[d_fiscal_year]" />
      <map key="[d_fiscal_quarter]" value="[Date].[d_fiscal_quarter]" />
      <map key="[d_fiscal_month]" value="[Date].[d_fiscal_month]" />
      <map key="[si_stock_item_key]" value="[Stock Item].[si_stock_item_key]" />
      <map key="[si_wwi_stock_item_id]" value="[Stock Item].[si_wwi_stock_item_id]" />
      <map key="[si_stock_item]" value="[Stock Item].[si_stock_item]" />
      <map key="[si_brand]" value="[Stock Item].[si_brand]" />
      <map key="[si_color]" value="[Stock Item].[si_color]" />
      <map key="[si_size]" value="[Stock Item].[si_size]" />
      <map key="[si_selling_package]" value="[Stock Item].[si_selling_package]" />
      <map key="[si_is_chiller_stock]" value="[Stock Item].[si_is_chiller_stock]" />
      <map key="[csi_wwi_stock_item_id]" value="[Current Stock Item].[csi_wwi_stock_item_id]" />
      <map key="[csi_stock_item]" value="[Current Stock Item].[csi_stock_item]" />
      <map key="[csi_color]" value="[Current Stock Item].[csi_color]" />
      <map key="[sg_wwi_stock_item_id]" value="[Stock Group Membership].[sg_wwi_stock_item_id]" />
      <map key="[sg_stock_group_id]" value="[Stock Group Membership].[sg_stock_group_id]" />
      <map key="[sg_stock_group_name]" value="[Stock Group Membership].[sg_stock_group_name]" />
    </cols>
  </connection>
  <aliases enabled="yes" />
  <column caption="Snapshot Date" datatype="date" name="[stk_snapshot_date]" role="dimension" type="ordinal">
    <desc>
      <formatted-text>
        <run>Date of the daily stock snapshot.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Snapshot Stock Item ID" datatype="integer" name="[stk_wwi_stock_item_id]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Snapshot Stock Item Key" datatype="integer" name="[stk_stock_item_key]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Quantity On Hand" datatype="integer" name="[stk_quantity_on_hand]" role="measure" type="quantitative" aggregation="Sum" hidden="true" />
  <column caption="Balance Basis" datatype="string" name="[stk_balance_basis]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>How the daily balance was derived: holding_backcast or flow_min_opening (SPEC § 5.3 rule 6).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Item Units Sold 91 Days" datatype="integer" name="[stk_units_sold_91d]" role="measure" type="quantitative" aggregation="Sum" hidden="true" />
  <column caption="Date" datatype="date" name="[d_date_key]" role="dimension" type="ordinal" />
  <column caption="Calendar Year" datatype="integer" name="[d_calendar_year]" role="dimension" type="ordinal" />
  <column caption="Calendar Quarter" datatype="integer" name="[d_calendar_quarter]" role="dimension" type="ordinal" />
  <column caption="Calendar Month" datatype="integer" name="[d_calendar_month]" role="dimension" type="ordinal" />
  <column caption="Month Name" datatype="string" name="[d_month_name]" role="dimension" type="nominal" />
  <column caption="Month Start Date" datatype="date" name="[d_month_start_date]" role="dimension" type="ordinal" />
  <column caption="Date day_of_month" datatype="integer" name="[d_day_of_month]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Date day_of_year" datatype="integer" name="[d_day_of_year]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Day of Week" datatype="integer" name="[d_day_of_week]" role="dimension" type="ordinal" />
  <column caption="Date day_name" datatype="string" name="[d_day_name]" role="dimension" type="nominal" hidden="true" />
  <column caption="Fiscal Year" datatype="integer" name="[d_fiscal_year]" role="dimension" type="ordinal" />
  <column caption="Fiscal Quarter" datatype="integer" name="[d_fiscal_quarter]" role="dimension" type="ordinal" />
  <column caption="Fiscal Month" datatype="integer" name="[d_fiscal_month]" role="dimension" type="ordinal" />
  <column caption="Stock Item Key" datatype="integer" name="[si_stock_item_key]" role="dimension" type="ordinal" hidden="true" />
  <column caption="WWI Stock Item ID" datatype="integer" name="[si_wwi_stock_item_id]" role="dimension" type="ordinal">
    <desc>
      <formatted-text>
        <run>Durable stock item id, stable across SCD2 versions.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Stock Item" datatype="string" name="[si_stock_item]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Product as recorded at the time of sale (SCD Type 2); current attributes via the durable item id. Also called: product, item, SKU, article.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Brand" datatype="string" name="[si_brand]" role="dimension" type="nominal" />
  <column caption="Color" datatype="string" name="[si_color]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Stock item color as recorded at the time of the fact (as-was, SCD2).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Size" datatype="string" name="[si_size]" role="dimension" type="nominal" />
  <column caption="Selling Package" datatype="string" name="[si_selling_package]" role="dimension" type="nominal" />
  <column caption="Is Chiller Stock" datatype="boolean" name="[si_is_chiller_stock]" role="dimension" type="nominal" />
  <column caption="Current Stock Item ID" datatype="integer" name="[csi_wwi_stock_item_id]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Current Stock Item" datatype="string" name="[csi_stock_item]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Stock item name in its current version (as-is).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Current Color" datatype="string" name="[csi_color]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Stock item color in its current version (as-is, SCD2).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Stock Group Item ID" datatype="integer" name="[sg_wwi_stock_item_id]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Stock Group ID" datatype="integer" name="[sg_stock_group_id]" role="dimension" type="ordinal" hidden="true" />
  <column caption="Stock Group" datatype="string" name="[sg_stock_group_name]" role="dimension" type="nominal">
    <desc>
      <formatted-text>
        <run>Product group; an item can belong to several groups, so group totals overlap. Also called: category, product group, product category, department.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Period End Snapshot Date" datatype="date" name="[x_period_end]" role="dimension" type="ordinal" hidden="true">
    <calculation class="tableau" formula="{EXCLUDE [si_wwi_stock_item_id], [si_stock_item], [si_brand], [si_color], [si_size], [si_selling_package], [si_is_chiller_stock], [csi_stock_item], [csi_color], [sg_stock_group_name], [stk_balance_basis] : MAX([stk_snapshot_date])}" />
    <desc>
      <formatted-text>
        <run>Last snapshot date of the period in context, ignoring item and group attributes in the view.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Closing Stock On Hand" datatype="real" name="[m_closing_stock]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="SUM(IF [stk_snapshot_date] = [x_period_end] THEN [stk_quantity_on_hand] END)" />
    <desc>
      <formatted-text>
        <run>Units on hand on the last day of the period (semi-additive); summed across stock items and stock groups. Value on the last snapshot date of the period in context. Also called: stock on hand, inventory, closing inventory, ending inventory, units in stock.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Units Sold Trailing 91 Days" datatype="real" name="[m_units_sold_91d]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="SUM(IF [stk_snapshot_date] = [x_period_end] THEN [stk_units_sold_91d] END)" />
    <desc>
      <formatted-text>
        <run>Units sold in the 91 days ending on the last snapshot date of the period, for the items in context; blank when no unit sold.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Days of Supply" datatype="real" name="[m_days_of_supply]" role="measure" type="quantitative" default-format="n#,##0.0">
    <calculation class="tableau" formula="[m_closing_stock] / ([m_units_sold_91d] / 91)" />
    <desc>
      <formatted-text>
        <run>Closing Stock On Hand divided by average daily Units Sold over the 91 days ending on the period end. Defined only by date and stock item attributes. Also called: DOS, days of inventory, inventory cover, stock cover, weeks of supply.</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Snapshot Row Count" datatype="integer" name="[m_snapshot_rows]" role="measure" type="quantitative" default-format="n#,##0">
    <calculation class="tableau" formula="COUNT([stk_snapshot_date])" />
    <desc>
      <formatted-text>
        <run>Number of item-day snapshot rows in context (row presence of the stock fact).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="Closing Snapshot Date" datatype="date" name="[m_closing_date]" role="measure" type="quantitative">
    <calculation class="tableau" formula="MAX([x_period_end])" />
    <desc>
      <formatted-text>
        <run>Last snapshot date of the period in context (the date closing stock is taken on).</run>
      </formatted-text>
    </desc>
  </column>
  <column caption="RLS Inventory Filter" datatype="boolean" name="[rls_wwi_inventory]" role="dimension" type="nominal" hidden="true">
    <calculation class="tableau" formula="NOT ISMEMBEROF('slc_territory_southeast') AND NOT ISNULL([stk_snapshot_date])" />
    <desc>
      <formatted-text>
        <run>Row-level security: the Southeast territory group has no inventory access.</run>
      </formatted-text>
    </desc>
  </column>
  <filter class="categorical" column="[rls_wwi_inventory]" logical-table-scoped="true">
    <groupfilter function="member" level="[rls_wwi_inventory]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
  </filter>
  <object-graph>
    <objects>
      <object caption="Stock Daily" id="stock_daily">
        <properties context="">
          <relation connection="databricks.slc" name="Stock Daily" type="text">SELECT h.snapshot_date AS stk_snapshot_date, h.wwi_stock_item_id AS stk_wwi_stock_item_id, h.stock_item_key AS stk_stock_item_key, h.quantity_on_hand AS stk_quantity_on_hand, h.balance_basis AS stk_balance_basis, SUM(s.units_sold) OVER (PARTITION BY h.wwi_stock_item_id ORDER BY h.snapshot_date ROWS BETWEEN 90 PRECEDING AND CURRENT ROW) AS stk_units_sold_91d FROM slc.wwi.fact_stock_holding_daily h LEFT JOIN (SELECT si.wwi_stock_item_id, f.invoice_date, SUM(f.quantity) AS units_sold FROM slc.wwi.fact_sale f JOIN slc.wwi.dim_stock_item si ON si.stock_item_key = f.stock_item_key GROUP BY si.wwi_stock_item_id, f.invoice_date) s ON s.wwi_stock_item_id = h.wwi_stock_item_id AND s.invoice_date = h.snapshot_date</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Dense daily stock snapshot per stock item, with the item's units sold in the 91 days ending on the snapshot date (the snapshot has one row per item per day, so 91 rows are 91 days).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Date" id="date">
        <properties context="">
          <relation connection="databricks.slc" name="Date" type="text">SELECT date_key AS d_date_key, calendar_year AS d_calendar_year, calendar_quarter AS d_calendar_quarter, calendar_month AS d_calendar_month, month_name AS d_month_name, month_start_date AS d_month_start_date, day_of_month AS d_day_of_month, day_of_year AS d_day_of_year, day_of_week AS d_day_of_week, day_name AS d_day_name, fiscal_year AS d_fiscal_year, fiscal_quarter AS d_fiscal_quarter, fiscal_month AS d_fiscal_month FROM slc.wwi.dim_date</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Calendar of the snapshot date.</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Stock Item" id="stock_item">
        <properties context="">
          <relation connection="databricks.slc" name="Stock Item" type="text">SELECT stock_item_key AS si_stock_item_key, wwi_stock_item_id AS si_wwi_stock_item_id, stock_item AS si_stock_item, brand AS si_brand, color AS si_color, size AS si_size, selling_package AS si_selling_package, is_chiller_stock AS si_is_chiller_stock FROM slc.wwi.dim_stock_item</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Stock item version referenced by the fact's surrogate key (as-was attribution).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Current Stock Item" id="current_stock_item">
        <properties context="">
          <relation connection="databricks.slc" name="Current Stock Item" type="text">SELECT wwi_stock_item_id AS csi_wwi_stock_item_id, stock_item AS csi_stock_item, color AS csi_color FROM slc.wwi.dim_stock_item WHERE is_current</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Current version of each stock item, related through the durable id (as-is attribution).</run>
          </formatted-text>
        </table-description>
      </object>
      <object caption="Stock Group Membership" id="stock_group">
        <properties context="">
          <relation connection="databricks.slc" name="Stock Group Membership" type="text">SELECT b.wwi_stock_item_id AS sg_wwi_stock_item_id, g.stock_group_id AS sg_stock_group_id, g.stock_group_name AS sg_stock_group_name FROM slc.wwi.bridge_stock_item_group b JOIN slc.wwi.dim_stock_group g ON g.stock_group_id = b.stock_group_id</relation>
        </properties>
        <table-description>
          <formatted-text>
            <run>Stock item to stock group membership (many-to-many bridge with group names).</run>
          </formatted-text>
        </table-description>
      </object>
    </objects>
    <relationships>
      <relationship>
        <expression op="=">
          <expression op="[stk_snapshot_date]" />
          <expression op="[d_date_key]" />
        </expression>
        <first-end-point object-id="stock_daily" />
        <second-end-point object-id="date" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[stk_stock_item_key]" />
          <expression op="[si_stock_item_key]" />
        </expression>
        <first-end-point object-id="stock_daily" />
        <second-end-point object-id="stock_item" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[si_wwi_stock_item_id]" />
          <expression op="[csi_wwi_stock_item_id]" />
        </expression>
        <first-end-point object-id="stock_item" />
        <second-end-point object-id="current_stock_item" />
      </relationship>
      <relationship>
        <expression op="=">
          <expression op="[si_wwi_stock_item_id]" />
          <expression op="[sg_wwi_stock_item_id]" />
        </expression>
        <first-end-point object-id="stock_item" />
        <second-end-point object-id="stock_group" />
      </relationship>
    </relationships>
  </object-graph>
</datasource>
