// Q-N-C2-D2 Pace index at 2024-11-30 by payment type.
EVALUATE
SELECTCOLUMNS (
    SUMMARIZECOLUMNS (
        'Payment Type'[Payment Type Name],
        TREATAS ( { DATE ( 2024, 11, 30 ) }, 'Pickup Date'[Pickup Date] ),
        "mtd", [Trips MTD],
        "dom", [Days Elapsed in Month],
        "ytd", [Trips YTD],
        "doy", [Days Elapsed in Year],
        "pace", [MTD-to-YTD Daily Pace Index]
    ),
    "payment_type_name", 'Payment Type'[Payment Type Name],
    "mtd_trips", [mtd],
    "day_of_month", [dom],
    "ytd_trips", [ytd],
    "day_of_year", [doy],
    "pace_index", [pace]
)
ORDER BY [payment_type_name]
