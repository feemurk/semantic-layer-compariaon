// Q-N-S2-D4 Card tips by payment type for 2024: a value only for payment type 1, blank for every other code. Members come from
// the Payment Type dimension, so codes without 2024 trips are listed too.
EVALUATE
SELECTCOLUMNS (
    SUMMARIZE ( 'Payment Type', 'Payment Type'[Payment Type], 'Payment Type'[Payment Type Name] ),
    "payment_type", 'Payment Type'[Payment Type],
    "payment_type_name", 'Payment Type'[Payment Type Name],
    "card_tips", CALCULATE ( [Card Tips], 'Pickup Date'[Pickup Calendar Year] = 2024 )
)
ORDER BY [payment_type]
