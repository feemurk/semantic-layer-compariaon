// Q-N-M1-D4 Among Manhattan pickup zones, the 10 with the most distinct OD pairs in 2024 (ties: zone id).
DEFINE
    VAR zones =
        SUMMARIZECOLUMNS (
            'Pickup Zone'[Pickup Location ID],
            'Pickup Zone'[Pickup Zone],
            TREATAS ( { 2024 }, 'Pickup Date'[Pickup Calendar Year] ),
            TREATAS ( { "Manhattan" }, 'Pickup Zone'[Pickup Borough] ),
            "pairs", [Distinct OD Pairs]
        )
    VAR ranked =
        ADDCOLUMNS ( zones, "rank_no", ROWNUMBER ( zones, ORDERBY ( [pairs], DESC, 'Pickup Zone'[Pickup Location ID], ASC ) ) )
EVALUATE
SELECTCOLUMNS (
    FILTER ( ranked, [rank_no] <= 10 ),
    "rank_no", [rank_no],
    "pu_location_id", 'Pickup Zone'[Pickup Location ID],
    "zone", 'Pickup Zone'[Pickup Zone],
    "distinct_od_pairs", [pairs]
)
ORDER BY [rank_no]
