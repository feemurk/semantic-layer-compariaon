// Q-W-M2-D3 Closing stock on hand at 2015-12-31 vs 2014-12-31 by selling package and chiller flag (as-was item attributes).
DEFINE
    VAR base =
        SUMMARIZECOLUMNS (
            'Stock Item'[Selling Package],
            'Stock Item'[Is Chiller Stock],
            TREATAS ( { DATE ( 2014, 12, 31 ), DATE ( 2015, 12, 31 ) }, 'Date'[Date] ),
            "units", [Closing Stock On Hand]
        )
EVALUATE
SELECTCOLUMNS (
    base,
    "selling_package", 'Stock Item'[Selling Package],
    "is_chiller_stock", 'Stock Item'[Is Chiller Stock],
    "closing_units_2014", CALCULATE ( [Closing Stock On Hand], 'Date'[Date] = DATE ( 2014, 12, 31 ) ),
    "closing_units_2015", CALCULATE ( [Closing Stock On Hand], 'Date'[Date] = DATE ( 2015, 12, 31 ) ),
    "change_units",
        VAR a = CALCULATE ( [Closing Stock On Hand], 'Date'[Date] = DATE ( 2014, 12, 31 ) )
        VAR b = CALCULATE ( [Closing Stock On Hand], 'Date'[Date] = DATE ( 2015, 12, 31 ) )
        RETURN IF ( ISBLANK ( a ) || ISBLANK ( b ), BLANK (), b - a )
)
ORDER BY [selling_package], [is_chiller_stock]
