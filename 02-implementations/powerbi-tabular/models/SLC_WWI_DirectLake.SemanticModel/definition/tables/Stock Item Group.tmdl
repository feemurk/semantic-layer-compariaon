		isHidden
		lineageTag: 6b05e538-b3e0-5b40-b991-22c6710b4c4f
		summarizeBy: none
		sourceColumn: stock_group_id

	partition 'Stock Item Group' = entity
		mode: directLake
		source
			entityName: bridge_stock_item_group
			schemaName: wwi
			expressionSource: 'DirectLake - slc'
