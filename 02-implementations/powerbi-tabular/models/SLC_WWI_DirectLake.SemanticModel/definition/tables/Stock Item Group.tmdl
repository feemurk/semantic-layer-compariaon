/// Bridge between stock items (durable id) and stock groups (many-to-many).
table 'Stock Item Group'
	isHidden
	lineageTag: f625a1e2-d3f5-5dd2-8632-88b7255c48d4

	/// Durable stock item id.
	column wwi_stock_item_id
		dataType: int64
		isHidden
		lineageTag: cd3cda0d-ccb9-5940-b6e7-2561e739fdca
		summarizeBy: none
		sourceColumn: wwi_stock_item_id

	/// Stock group id.
	column stock_group_id
