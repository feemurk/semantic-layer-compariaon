/// Shared calendar with a fiscal year starting 1 November, labeled by the year in which it ends.
table Date
	dataCategory: Time
	lineageTag: 4c6f58a3-722e-57a0-a543-a8af3138ab62

	/// Calendar date of the invoice, order or stock snapshot.
	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-MM-dd
		lineageTag: 0d6237c0-84c1-5d95-b657-93a8f6c49909
		summarizeBy: none
		sourceColumn: date_key

	/// Calendar year.
	column 'Calendar Year'
		dataType: int64
		formatString: 0
		lineageTag: 46f20eb8-a18f-5c86-9b31-e89b28c0d74f
		summarizeBy: none
		sourceColumn: calendar_year

	/// Calendar quarter 1-4.
	column 'Calendar Quarter'
