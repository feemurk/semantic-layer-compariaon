		formatString: 0
		lineageTag: c456d1b1-bc52-5acd-b77f-d7fca4361973
		summarizeBy: none
		sourceColumn: calendar_quarter

	/// Calendar month 1-12.
	column 'Calendar Month'
		dataType: int64
		formatString: 0
		lineageTag: a58ab90b-803f-5a29-b85f-22905b83e341
