	/// Day of the month.
	column 'Day of Month'
		dataType: int64
		formatString: 0
		lineageTag: 21a58a12-61cb-5447-bc4d-ff14512ca0ca
		summarizeBy: none
		sourceColumn: day_of_month

	/// Day of the year.
	column 'Day of Year'
		dataType: int64
		formatString: 0
		lineageTag: 470a55bf-41e6-5501-924a-35887c7d75d5
		summarizeBy: none
		sourceColumn: day_of_year

	/// ISO day of week, Monday = 1.
	column 'Day of Week'
		dataType: int64
		formatString: 0
		lineageTag: 1f4e94c4-9d9c-5939-8830-e58c81acd101
		summarizeBy: none
		sourceColumn: day_of_week

	/// Day name.
	column 'Day Name'
		dataType: string
		lineageTag: f335cb04-ba30-533b-9641-87e948984830
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: 'Day of Week'

	/// ISO week number.
	column 'ISO Week'
		dataType: int64
		formatString: 0
		lineageTag: cfc28e95-d924-5dfa-8fcd-35509d0ba85b
		summarizeBy: none
		sourceColumn: iso_week_number

	/// Fiscal year starting 1 November, labeled by the year in which it ends.
	column 'Fiscal Year'
		dataType: int64
		formatString: 0
		lineageTag: e5d0fdf4-3a30-50fe-876e-1a66f968c10f
		summarizeBy: none
		sourceColumn: fiscal_year

	/// Fiscal quarter 1-4 (Q1 = November-January).
	column 'Fiscal Quarter'
		dataType: int64
		formatString: 0
		lineageTag: d1ce2b15-74a4-5c2a-9ec6-59c248c1c612
		summarizeBy: none
		sourceColumn: fiscal_quarter

	/// Fiscal month 1-12 (November = 1).
	column 'Fiscal Month'
		dataType: int64
		formatString: 0
		lineageTag: c89ec2c7-efaf-524c-a2c2-bb050a4e5ddd
		summarizeBy: none
		sourceColumn: fiscal_month

	/// fiscal_year * 12 + fiscal_month; consecutive across years.
	column 'Fiscal Period'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 38561e88-7015-532c-bd19-02ea80b7dd41
		summarizeBy: none
		sourceColumn: fiscal_period_index

	/// Day of the fiscal year.
