		sourceColumn: month_name
		sortByColumn: 'Calendar Month'

	/// First day of the calendar month.
	column 'Month Start'
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 13a864ff-0783-5622-8eae-c265a4db6419
