/// NYC Yellow Taxi semantic model of the semantic layer comparison study (SPEC § 3.1 S2).
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

	annotation SLC_StorageVariant = directlake

ref table 'Pickup Date'
ref table 'Dropoff Date'
ref table 'Pickup Zone'
ref table 'Dropoff Zone'
ref table 'Payment Type'
ref table Trips

ref role 'Manhattan Pickup Analyst'

ref cultureInfo en-US
