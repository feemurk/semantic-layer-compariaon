<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs one DAX query over the Power BI XMLA endpoint and prints {"columns": [...], "rows": [[...]]} as JSON.
       Used by reconcile.py (transport xmla): executeQueries rejects service principals on models with RLS. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient" Version="19.117.0" />
  </ItemGroup>
</Project>
