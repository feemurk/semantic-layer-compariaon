  t.vendor_id,
  t.od_pair_id,
  t.trip_distance,
  t.fare_amount,
  t.tip_amount,
  t.tolls_amount,
  t.total_amount,
  CASE WHEN t.payment_type = 1 THEN t.tip_amount ELSE 0 END AS card_tip,
  CASE WHEN t.payment_type = 1 THEN 1 ELSE 0 END AS card_trip
FROM nyctaxi.fact_trip t
WHERE t.pickup_date &gt;= '2024-09-01' AND t.pickup_date &lt; '2024-10-01'</QueryDefinition>
