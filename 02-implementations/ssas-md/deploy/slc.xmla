  YEAR(t.dropoff_date) * 10000 + MONTH(t.dropoff_date) * 100 + DAY(t.dropoff_date) AS dropoff_date_id,
  t.pickup_hour,
  t.pu_location_id,
  t.do_location_id,
  t.payment_type,
  t.vendor_id,
  t.od_pair_id,
  t.trip_distance,
  t.fare_amount,
  t.tip_amount,
