                          <DataType>Integer</DataType>
                          <Source xsi:type="ColumnBinding">
                            <TableID>wwi_stock_holding</TableID>
                            <ColumnID>stock_item_key</ColumnID>
                          </Source>
                        </KeyColumn>
                      </KeyColumns>
                      <Type>Granularity</Type>
                    </Attribute>
                  </Attributes>
                </Dimension>
                <Dimension xsi:type="RegularMeasureGroupDimension">
                  <CubeDimensionID>Inventory Access</CubeDimensionID>
                  <Attributes>
                    <Attribute>
                      <AttributeID>Access</AttributeID>
                      <KeyColumns>
                        <KeyColumn>
                          <DataType>Integer</DataType>
