                    <xs:element name="nyc_date" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="nyc_date" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  YEAR(d.date_key) * 10000 + MONTH(d.date_key) * 100 + DAY(d.date_key) AS date_id,&#10;  CAST(d.date_key AS CHAR(10)) AS date_name,&#10;  YEAR(d.date_key) * 100 + MONTH(d.date_key) AS month_id,&#10;  CAST(d.month_start_date AS CHAR(10)) AS month_name,&#10;  CAST((SELECT MAX(e.date_key) FROM nyctaxi.dim_date e WHERE e.month_start_date = d.month_start_date) AS CHAR(10))&#10;    AS month_end_name,&#10;  d.calendar_month AS month_of_year,&#10;  CAST(d.calendar_month AS VARCHAR(2)) AS month_of_year_name,&#10;  CAST(d.calendar_year AS INTEGER) * 10 + d.calendar_quarter AS quarter_id,&#10;  CAST((SELECT MIN(e.date_key) FROM nyctaxi.dim_date e&#10;        WHERE e.calendar_year = d.calendar_year AND e.calendar_quarter = d.calendar_quarter) AS CHAR(10))&#10;    AS quarter_name,&#10;  d.calendar_year,&#10;  CAST(d.calendar_year AS VARCHAR(4)) AS calendar_year_name,&#10;  d.day_of_week,&#10;  CAST(d.day_of_week AS VARCHAR(1)) AS day_of_week_name,&#10;  d.day_name,&#10;  d.day_of_month,&#10;  CAST(d.day_of_month AS VARCHAR(2)) AS day_of_month_name,&#10;  d.day_of_year,&#10;  CAST(d.day_of_year AS VARCHAR(3)) AS day_of_year_name,&#10;  CASE&#10;    WHEN d.calendar_year - 1 &lt; (SELECT MIN(e.calendar_year) FROM nyctaxi.dim_date e) THEN NULL&#10;    WHEN d.calendar_month = 2 AND d.day_of_month = 29 THEN (CAST(d.calendar_year AS INTEGER) - 1) * 10000 + 228&#10;    ELSE (CAST(d.calendar_year AS INTEGER) - 1) * 10000 + CAST(d.calendar_month AS INTEGER) * 100 + d.day_of_month&#10;  END AS stly_date_id,&#10;  CAST(CASE&#10;    WHEN d.calendar_year - 1 &lt; (SELECT MIN(e.calendar_year) FROM nyctaxi.dim_date e) THEN NULL&#10;    WHEN d.calendar_month = 2 AND d.day_of_month = 29 THEN (CAST(d.calendar_year AS INTEGER) - 1) * 10000 + 228&#10;    ELSE (CAST(d.calendar_year AS INTEGER) - 1) * 10000 + CAST(d.calendar_month AS INTEGER) * 100 + d.day_of_month&#10;  END AS VARCHAR(8)) AS stly_date_id_name,&#10;  CASE WHEN d.calendar_year BETWEEN 2023 AND 2024 THEN 1 ELSE 0 END AS in_source_window,&#10;  CASE WHEN d.calendar_year BETWEEN 2023 AND 2024 THEN 'true' ELSE 'false' END AS in_source_window_name&#10;FROM nyctaxi.dim_date d" msprop:DbTableName="nyc_date">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="date_id" type="xs:int" />
                          <xs:element name="date_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="month_id" minOccurs="0" type="xs:int" />
                          <xs:element name="month_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="month_end_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="month_of_year" minOccurs="0" type="xs:unsignedByte" />
                          <xs:element name="month_of_year_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="quarter_id" minOccurs="0" type="xs:int" />
                          <xs:element name="quarter_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="calendar_year" minOccurs="0" type="xs:short" />
                          <xs:element name="calendar_year_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="day_of_week" minOccurs="0" type="xs:unsignedByte" />
                          <xs:element name="day_of_week_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="day_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="day_of_month" minOccurs="0" type="xs:unsignedByte" />
                          <xs:element name="day_of_month_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="day_of_year" minOccurs="0" type="xs:short" />
                          <xs:element name="day_of_year_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="stly_date_id" minOccurs="0" type="xs:int" />
                          <xs:element name="stly_date_id_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="in_source_window" minOccurs="0" type="xs:int" />
                          <xs:element name="in_source_window_name" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="255" />
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
