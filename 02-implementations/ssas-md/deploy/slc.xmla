                  <ID>Backorders</ID>
                  <Name>Backorders</Name>
                  <Source xsi:type="QueryBinding">
                    <DataSourceID>slc_adapter</DataSourceID>
                    <QueryDefinition>SELECT
  o.order_key,
  YEAR(o.order_date) * 10000 + MONTH(o.order_date) * 100 + DAY(o.order_date) AS order_date_id,
  o.customer_key,
  o.city_key,
  o.stock_item_key,
  o.salesperson_key,
  o.picker_key
FROM wwi.fact_order o
WHERE o.wwi_backorder_id IS NOT NULL</QueryDefinition>
                  </Source>
