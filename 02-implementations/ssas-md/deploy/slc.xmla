      <Cubes>
        <Cube>
          <ID>WWI</ID>
          <Name>WWI</Name>
          <Description>WideWorldImporters sales, orders and inventory (W-S1 to W-C2, B-W1 to B-W5).</Description>
          <Language>1033</Language>
          <Collation>Latin1_General_CI_AS</Collation>
          <Dimensions>
            <Dimension>
              <ID>Date</ID>
