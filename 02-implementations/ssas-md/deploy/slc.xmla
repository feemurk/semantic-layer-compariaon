                    <xs:element name="nyc_trips" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="nyc_trips" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  t.trip_id,&#10;  YEAR(t.pickup_date) * 10000 + MONTH(t.pickup_date) * 100 + DAY(t.pickup_date) AS pickup_date_id,&#10;  YEAR(t.dropoff_date) * 10000 + MONTH(t.dropoff_date) * 100 + DAY(t.dropoff_date) AS dropoff_date_id,&#10;  t.pickup_hour,&#10;  t.pu_location_id,&#10;  t.do_location_id,&#10;  t.payment_type,&#10;  t.vendor_id,&#10;  t.od_pair_id,&#10;  t.trip_distance,&#10;  t.fare_amount,&#10;  t.tip_amount,&#10;  t.tolls_amount,&#10;  t.total_amount,&#10;  CASE WHEN t.payment_type = 1 THEN t.tip_amount ELSE 0 END AS card_tip,&#10;  CASE WHEN t.payment_type = 1 THEN 1 ELSE 0 END AS card_trip&#10;FROM nyctaxi.fact_trip t" msprop:DbTableName="nyc_trips">
