            </MeasureGroup>
            <MeasureGroup>
              <ID>OD Pairs</ID>
              <Name>OD Pairs</Name>
              <Description>Distinct OD pair count in its dedicated measure group (B-06).</Description>
              <Measures>
                <Measure>
                  <ID>Distinct OD Pairs</ID>
                  <Name>Distinct OD Pairs</Name>
                  <Description>Exact count of distinct pickup zone to dropoff zone pairs. Additive across zone and borough of either role; not additive across time, payment type, vendor or hour.</Description>
                  <Annotations>
                    <Annotation>
                      <Name>slc:synonyms</Name>
                      <Value>origin destination pairs; OD pairs; unique routes; distinct routes</Value>
                    </Annotation>
                  </Annotations>
                  <AggregateFunction>DistinctCount</AggregateFunction>
                  <DataType>Integer</DataType>
                  <Source>
                    <DataType>Integer</DataType>
                    <NullProcessing>Preserve</NullProcessing>
                    <Source xsi:type="ColumnBinding">
                      <TableID>nyc_trips</TableID>
                      <ColumnID>od_pair_id</ColumnID>
                    </Source>
                  </Source>
                  <FormatString>#,##0</FormatString>
                </Measure>
              </Measures>
              <StorageMode>Molap</StorageMode>
              <IgnoreUnrelatedDimensions>false</IgnoreUnrelatedDimensions>
