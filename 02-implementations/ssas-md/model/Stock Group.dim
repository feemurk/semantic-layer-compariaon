<?xml version="1.0" encoding="utf-8"?>
<Dimension xmlns="http://schemas.microsoft.com/analysisservices/2003/engine" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ID>Stock Group</ID>
  <Name>Stock Group</Name>
  <Description>Product group; an item can belong to several groups, so group values overlap while totals are deduplicated (many-to-many through the Stock Item Group Bridge).</Description>
  <Source xsi:type="DataSourceViewBinding">
    <DataSourceViewID>slc</DataSourceViewID>
  </Source>
  <Type>Regular</Type>
  <UnknownMember>None</UnknownMember>
  <Language>1033</Language>
  <Collation>Latin1_General_CI_AS</Collation>
  <UnknownMemberName>Unknown</UnknownMemberName>
  <Attributes>
    <Attribute>
      <ID>Stock Group</ID>
      <Name>Stock Group</Name>
      <Usage>Key</Usage>
      <KeyColumns>
        <KeyColumn>
          <DataType>Integer</DataType>
          <Source xsi:type="ColumnBinding">
            <TableID>wwi_stock_group</TableID>
            <ColumnID>stock_group_id</ColumnID>
          </Source>
        </KeyColumn>
      </KeyColumns>
      <NameColumn>
        <DataType>WChar</DataType>
        <DataSize>255</DataSize>
        <NullProcessing>ZeroOrBlank</NullProcessing>
        <Source xsi:type="ColumnBinding">
          <TableID>wwi_stock_group</TableID>
          <ColumnID>stock_group_name</ColumnID>
        </Source>
      </NameColumn>
      <OrderBy>Key</OrderBy>
    </Attribute>
  </Attributes>
</Dimension>
