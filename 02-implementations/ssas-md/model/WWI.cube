    <MeasureGroup>
      <ID>Stock Holdings</ID>
      <Name>Stock Holdings</Name>
      <Description>Dense daily stock snapshot (fact_stock_holding_daily).</Description>
      <Measures>
        <Measure>
          <ID>Closing Units</ID>
          <Name>Closing Units</Name>
          <Description>Units on hand on the last day of the period (semi-additive); summed across stock items and stock groups.</Description>
          <Annotations>
            <Annotation>
              <Name>slc:synonyms</Name>
              <Value>stock on hand; inventory; closing inventory; ending inventory; units in stock</Value>
            </Annotation>
          </Annotations>
          <AggregateFunction>LastNonEmpty</AggregateFunction>
          <DataType>BigInt</DataType>
          <Source>
            <DataType>Integer</DataType>
            <NullProcessing>Preserve</NullProcessing>
            <Source xsi:type="ColumnBinding">
              <TableID>wwi_stock_holding</TableID>
              <ColumnID>quantity_on_hand</ColumnID>
            </Source>
          </Source>
          <FormatString>#,##0</FormatString>
        </Measure>
        <Measure>
          <ID>Stock Snapshot Rows</ID>
          <Name>Stock Snapshot Rows</Name>
          <AggregateFunction>Count</AggregateFunction>
          <DataType>Integer</DataType>
          <Source>
            <DataType>Integer</DataType>
            <DataSize>4</DataSize>
            <Source xsi:type="RowBinding">
              <TableID>wwi_stock_holding</TableID>
            </Source>
          </Source>
          <Visible>false</Visible>
          <FormatString>#,##0</FormatString>
        </Measure>
      </Measures>
      <StorageMode>Molap</StorageMode>
      <IgnoreUnrelatedDimensions>false</IgnoreUnrelatedDimensions>
      <Dimensions>
        <Dimension xsi:type="RegularMeasureGroupDimension">
          <CubeDimensionID>Date</CubeDimensionID>
          <Attributes>
            <Attribute>
              <AttributeID>Date</AttributeID>
              <KeyColumns>
                <KeyColumn>
                  <DataType>Integer</DataType>
                  <Source xsi:type="ColumnBinding">
                    <TableID>wwi_stock_holding</TableID>
                    <ColumnID>snapshot_date_id</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
        <Dimension xsi:type="RegularMeasureGroupDimension">
          <CubeDimensionID>Stock Item</CubeDimensionID>
          <Attributes>
            <Attribute>
              <AttributeID>Stock Item Key</AttributeID>
              <KeyColumns>
                <KeyColumn>
                  <DataType>Integer</DataType>
                  <Source xsi:type="ColumnBinding">
                    <TableID>wwi_stock_holding</TableID>
                    <ColumnID>stock_item_key</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
        <Dimension xsi:type="RegularMeasureGroupDimension">
          <CubeDimensionID>Inventory Access</CubeDimensionID>
          <Attributes>
            <Attribute>
              <AttributeID>Access</AttributeID>
              <KeyColumns>
                <KeyColumn>
                  <DataType>Integer</DataType>
                  <Source xsi:type="ColumnBinding">
                    <TableID>wwi_stock_holding</TableID>
                    <ColumnID>access_key</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
        <Dimension xsi:type="ManyToManyMeasureGroupDimension">
          <CubeDimensionID>Stock Group</CubeDimensionID>
          <MeasureGroupID>Stock Item Group Bridge</MeasureGroupID>
        </Dimension>
      </Dimensions>
      <Partitions>
        <Partition>
          <ID>Stock Holdings</ID>
          <Name>Stock Holdings</Name>
          <Source xsi:type="QueryBinding">
            <DataSourceID>slc_adapter</DataSourceID>
            <QueryDefinition>SELECT
  YEAR(h.snapshot_date) * 10000 + MONTH(h.snapshot_date) * 100 + DAY(h.snapshot_date) AS snapshot_date_id,
  h.stock_item_key,
  h.wwi_stock_item_id,
  h.quantity_on_hand,
  1 AS access_key
FROM wwi.fact_stock_holding_daily h</QueryDefinition>
          </Source>
          <StorageMode>Molap</StorageMode>
        </Partition>
      </Partitions>
    </MeasureGroup>
