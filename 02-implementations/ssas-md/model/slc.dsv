<?xml version="1.0" encoding="utf-8"?>
<DataSourceView xmlns="http://schemas.microsoft.com/analysisservices/2003/engine" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns:msprop="urn:schemas-microsoft-com:xml-msprop" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <ID>slc</ID>
  <Name>slc</Name>
  <DataSourceID>slc_adapter</DataSourceID>
  <Schema>
    <xs:schema id="slc">
      <xs:element name="slc" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="wwi_date" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_date" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  YEAR(d.date_key) * 10000 + MONTH(d.date_key) * 100 + DAY(d.date_key) AS date_id,&#10;  CAST(d.date_key AS CHAR(10)) AS date_name,&#10;  YEAR(d.date_key) * 100 + MONTH(d.date_key) AS month_id,&#10;  CAST(d.month_start_date AS CHAR(10)) AS month_name,&#10;  CAST((SELECT MAX(e.date_key) FROM wwi.dim_date e WHERE e.month_start_date = d.month_start_date) AS CHAR(10))&#10;    AS month_end_name,&#10;  d.calendar_month AS month_of_year,&#10;  CAST(d.calendar_month AS VARCHAR(2)) AS month_of_year_name,&#10;  CAST(d.calendar_year AS INTEGER) * 10 + d.calendar_quarter AS quarter_id,&#10;  CONCAT(CAST(d.calendar_year AS VARCHAR(4)), ' Q', CAST(d.calendar_quarter AS VARCHAR(1))) AS quarter_name,&#10;  CAST((SELECT MAX(e.date_key) FROM wwi.dim_date e&#10;        WHERE e.calendar_year = d.calendar_year AND e.calendar_quarter = d.calendar_quarter) AS CHAR(10))&#10;    AS quarter_end_name,&#10;  d.calendar_quarter AS quarter_of_year,&#10;  CAST(d.calendar_quarter AS VARCHAR(1)) AS quarter_of_year_name,&#10;  d.calendar_year,&#10;  CAST(d.calendar_year AS VARCHAR(4)) AS calendar_year_name,&#10;  d.fiscal_period_index AS fiscal_month_id,&#10;  CONCAT('FY', CAST(d.fiscal_year AS VARCHAR(4)), ' M', CAST(d.fiscal_month AS VARCHAR(2))) AS fiscal_month_name,&#10;  d.fiscal_month AS fiscal_month_of_year,&#10;  CAST(d.fiscal_month AS VARCHAR(2)) AS fiscal_month_of_year_name,&#10;  CAST(d.fiscal_year AS INTEGER) * 10 + d.fiscal_quarter AS fiscal_quarter_id,&#10;  CONCAT('FY', CAST(d.fiscal_year AS VARCHAR(4)), ' Q', CAST(d.fiscal_quarter AS VARCHAR(1))) AS fiscal_quarter_name,&#10;  d.fiscal_quarter AS fiscal_quarter_of_year,&#10;  CAST(d.fiscal_quarter AS VARCHAR(1)) AS fiscal_quarter_of_year_name,&#10;  d.fiscal_year,&#10;  CAST(d.fiscal_year AS VARCHAR(4)) AS fiscal_year_name&#10;FROM wwi.dim_date d" msprop:DbTableName="wwi_date">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="date_id" type="xs:int" />
                  <xs:element name="date_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="month_id" minOccurs="0" type="xs:int" />
                  <xs:element name="month_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="month_end_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="month_of_year" minOccurs="0" type="xs:unsignedByte" />
                  <xs:element name="month_of_year_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="quarter_id" minOccurs="0" type="xs:int" />
                  <xs:element name="quarter_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="quarter_end_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="quarter_of_year" minOccurs="0" type="xs:unsignedByte" />
                  <xs:element name="quarter_of_year_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="calendar_year" minOccurs="0" type="xs:short" />
                  <xs:element name="calendar_year_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="fiscal_month_id" minOccurs="0" type="xs:int" />
                  <xs:element name="fiscal_month_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="fiscal_month_of_year" minOccurs="0" type="xs:unsignedByte" />
                  <xs:element name="fiscal_month_of_year_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="fiscal_quarter_id" minOccurs="0" type="xs:int" />
                  <xs:element name="fiscal_quarter_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="fiscal_quarter_of_year" minOccurs="0" type="xs:unsignedByte" />
                  <xs:element name="fiscal_quarter_of_year_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="fiscal_year" minOccurs="0" type="xs:short" />
                  <xs:element name="fiscal_year_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="wwi_customer" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_customer" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  c.customer_key,&#10;  c.customer,&#10;  c.category,&#10;  c.buying_group&#10;FROM wwi.dim_customer c" msprop:DbTableName="wwi_customer">
