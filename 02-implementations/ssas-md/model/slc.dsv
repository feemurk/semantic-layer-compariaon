            <xs:element name="wwi_stock_item" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_stock_item" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  s.stock_item_key,&#10;  s.wwi_stock_item_id,&#10;  CAST(s.wwi_stock_item_id AS VARCHAR(10)) AS wwi_stock_item_id_name,&#10;  s.stock_item,&#10;  s.color,&#10;  c.color AS current_color,&#10;  s.brand,&#10;  s.size,&#10;  s.selling_package,&#10;  CASE WHEN s.is_chiller_stock = 1 THEN 'true' ELSE 'false' END AS is_chiller_stock,&#10;  b.balance_basis&#10;FROM wwi.dim_stock_item s&#10;LEFT JOIN wwi.dim_stock_item c&#10;  ON c.wwi_stock_item_id = s.wwi_stock_item_id AND c.is_current = 1&#10;LEFT JOIN (&#10;  SELECT h.wwi_stock_item_id, MAX(h.balance_basis) AS balance_basis&#10;  FROM wwi.fact_stock_holding_daily h&#10;  GROUP BY h.wwi_stock_item_id&#10;) b ON b.wwi_stock_item_id = s.wwi_stock_item_id" msprop:DbTableName="wwi_stock_item">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="stock_item_key" type="xs:int" />
                  <xs:element name="wwi_stock_item_id" minOccurs="0" type="xs:int" />
                  <xs:element name="wwi_stock_item_id_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="stock_item" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="color" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="current_color" minOccurs="0">
