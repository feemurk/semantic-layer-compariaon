                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="brand" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="size" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="selling_package" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="is_chiller_stock" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="balance_basis" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="wwi_stock_group" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_stock_group" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  g.stock_group_id,&#10;  g.stock_group_name&#10;FROM wwi.dim_stock_group g" msprop:DbTableName="wwi_stock_group">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="stock_group_id" type="xs:int" />
                  <xs:element name="stock_group_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="wwi_employee" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_employee" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  e.employee_key,&#10;  e.employee&#10;FROM wwi.dim_employee e" msprop:DbTableName="wwi_employee">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="employee_key" type="xs:int" />
                  <xs:element name="employee" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="255" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="wwi_inventory_access" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_inventory_access" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  1 AS access_key,&#10;  'Granted' AS access_name" msprop:DbTableName="wwi_inventory_access">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="access_key" type="xs:int" />
                  <xs:element name="access_name" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
