                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="wwi_sales" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_sales" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  f.sale_key,&#10;  YEAR(f.invoice_date) * 10000 + MONTH(f.invoice_date) * 100 + DAY(f.invoice_date) AS invoice_date_id,&#10;  YEAR(f.delivery_date) * 10000 + MONTH(f.delivery_date) * 100 + DAY(f.delivery_date) AS delivery_date_id,&#10;  f.customer_key,&#10;  f.bill_to_customer_key,&#10;  f.city_key,&#10;  f.stock_item_key,&#10;  f.salesperson_key,&#10;  f.wwi_invoice_id,&#10;  f.quantity,&#10;  f.total_excluding_tax,&#10;  f.total_including_tax,&#10;  f.profit&#10;FROM wwi.fact_sale f" msprop:DbTableName="wwi_sales">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="sale_key" type="xs:long" />
                  <xs:element name="invoice_date_id" minOccurs="0" type="xs:int" />
                  <xs:element name="delivery_date_id" minOccurs="0" type="xs:int" />
                  <xs:element name="customer_key" minOccurs="0" type="xs:int" />
                  <xs:element name="bill_to_customer_key" minOccurs="0" type="xs:int" />
                  <xs:element name="city_key" minOccurs="0" type="xs:int" />
                  <xs:element name="stock_item_key" minOccurs="0" type="xs:int" />
                  <xs:element name="salesperson_key" minOccurs="0" type="xs:int" />
                  <xs:element name="wwi_invoice_id" minOccurs="0" type="xs:int" />
                  <xs:element name="quantity" minOccurs="0" type="xs:int" />
                  <xs:element name="total_excluding_tax" minOccurs="0" type="xs:decimal" />
                  <xs:element name="total_including_tax" minOccurs="0" type="xs:decimal" />
                  <xs:element name="profit" minOccurs="0" type="xs:decimal" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="wwi_orders" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_orders" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  o.order_key,&#10;  YEAR(o.order_date) * 10000 + MONTH(o.order_date) * 100 + DAY(o.order_date) AS order_date_id,&#10;  o.customer_key,&#10;  o.city_key,&#10;  o.stock_item_key,&#10;  o.salesperson_key,&#10;  o.picker_key,&#10;  o.quantity&#10;FROM wwi.fact_order o" msprop:DbTableName="wwi_orders">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="order_key" type="xs:long" />
                  <xs:element name="order_date_id" minOccurs="0" type="xs:int" />
                  <xs:element name="customer_key" minOccurs="0" type="xs:int" />
                  <xs:element name="city_key" minOccurs="0" type="xs:int" />
                  <xs:element name="stock_item_key" minOccurs="0" type="xs:int" />
                  <xs:element name="salesperson_key" minOccurs="0" type="xs:int" />
                  <xs:element name="picker_key" minOccurs="0" type="xs:int" />
                  <xs:element name="quantity" minOccurs="0" type="xs:int" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="wwi_backorders" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_backorders" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  o.order_key,&#10;  YEAR(o.order_date) * 10000 + MONTH(o.order_date) * 100 + DAY(o.order_date) AS order_date_id,&#10;  o.customer_key,&#10;  o.city_key,&#10;  o.stock_item_key,&#10;  o.salesperson_key,&#10;  o.picker_key&#10;FROM wwi.fact_order o&#10;WHERE o.wwi_backorder_id IS NOT NULL" msprop:DbTableName="wwi_backorders">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="order_key" type="xs:long" />
                  <xs:element name="order_date_id" minOccurs="0" type="xs:int" />
                  <xs:element name="customer_key" minOccurs="0" type="xs:int" />
                  <xs:element name="city_key" minOccurs="0" type="xs:int" />
                  <xs:element name="stock_item_key" minOccurs="0" type="xs:int" />
                  <xs:element name="salesperson_key" minOccurs="0" type="xs:int" />
                  <xs:element name="picker_key" minOccurs="0" type="xs:int" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="wwi_stock_holding" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_stock_holding" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  YEAR(h.snapshot_date) * 10000 + MONTH(h.snapshot_date) * 100 + DAY(h.snapshot_date) AS snapshot_date_id,&#10;  h.stock_item_key,&#10;  h.wwi_stock_item_id,&#10;  h.quantity_on_hand,&#10;  1 AS access_key&#10;FROM wwi.fact_stock_holding_daily h" msprop:DbTableName="wwi_stock_holding">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="snapshot_date_id" minOccurs="0" type="xs:int" />
                  <xs:element name="stock_item_key" minOccurs="0" type="xs:int" />
                  <xs:element name="wwi_stock_item_id" minOccurs="0" type="xs:int" />
                  <xs:element name="quantity_on_hand" minOccurs="0" type="xs:int" />
                  <xs:element name="access_key" minOccurs="0" type="xs:int" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="wwi_stock_item_group" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_stock_item_group" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  b.wwi_stock_item_id,&#10;  b.stock_group_id&#10;FROM wwi.bridge_stock_item_group b" msprop:DbTableName="wwi_stock_item_group">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="wwi_stock_item_id" minOccurs="0" type="xs:int" />
                  <xs:element name="stock_group_id" minOccurs="0" type="xs:int" />
                </xs:sequence>
