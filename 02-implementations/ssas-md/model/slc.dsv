            <xs:element name="wwi_city" msprop:TableType="View" msprop:IsLogical="True" msprop:FriendlyName="wwi_city" msprop:QueryBuilder="GenericQueryBuilder" msprop:QueryDefinition="SELECT&#10;  c.city_key,&#10;  c.city,&#10;  c.state_province,&#10;  c.country,&#10;  c.continent,&#10;  c.sales_territory&#10;FROM wwi.dim_city c" msprop:DbTableName="wwi_city">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="city_key" type="xs:int" />
                  <xs:element name="city" minOccurs="0">
